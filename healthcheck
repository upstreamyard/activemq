#!/bin/bash
# Healthy when the broker accepts TCP connections on the port the entrypoint chose: the
# first transport in ACTIVEMQ_TRANSPORTS (OpenWire, 61616, by default), 61616 with a mounted
# activemq.xml, or ACTIVEMQ_HEALTHCHECK_PORT. A master/slave standby waits for the store
# lock without listening, so it reports unhealthy until it takes over.
port=$(cat /tmp/activemq/healthcheck-port 2>/dev/null || echo 61616)
exec 3<>"/dev/tcp/127.0.0.1/$port"
